# Local dev env vars for cmd/worker-agent.
# Usage: source scripts/worker-agent.env   (run this in the worker-agent tab
# BEFORE `go run ./cmd/worker-agent`, every time you open a fresh terminal)
#
# FLEETFORGE_INSTANCE_ID must stay stable across restarts of the SAME
# simulated worker -- it's how the scheduler recognizes "this is the same
# machine re-registering" vs "this is a brand new worker" (docs/06-failure-scenarios.md).
# Change it only if you deliberately want to simulate a second, different worker.
export FLEETFORGE_INSTANCE_ID="dev-worker-1"
export FLEETFORGE_CPU_CORES=4
export FLEETFORGE_MEMORY_MB=8192
export FLEETFORGE_CAPACITY_SLOTS=1
